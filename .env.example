# Never commit real secrets.
TELEGRAM_BOT_TOKEN=
WEB_ORIGIN=http://localhost:5173
PORT=3000
HOST=127.0.0.1
DB_PATH=./data/ideaflow.db
# Local development ONLY. Hard-disabled when NODE_ENV=production.
DEV_AUTH_BYPASS=true
NODE_ENV=development
# Optional Gemini classification. Without a key a deterministic rule-based classifier is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Comma-separated project names the classifier may assign (e.g. SputnikVPN, Work).
PROJECT_ALLOWLIST=
# fatal|error|warn|info|debug
LOG_LEVEL=info
